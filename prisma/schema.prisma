// 데이터 모델: docs/SPEC.md 7장 (검색·문의), docs/SEO_SPEC.md 3장 (부품 페이지)
// 유통사에서 수집한 가격·재고는 저장하지 않는다. 부품 테이블은 관리자가 직접 입력한 콘텐츠만 담는다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InquiryType {
  quote
  sourcing
  /// 부품 요청 (견적·소싱 통합, 여러 품목 + 첨부). 2026-10 이후 신규 접수는 모두 이 종류
  request
}

/// 이번 구매 품목 수 (BOM 수요 검증용)
enum ItemCountBucket {
  one
  two_to_ten
  eleven_plus
}

enum PurchaseType {
  company
  personal
}

enum InquiryStatus {
  new
  contacted
  quoted
  won
  lost
}

enum NotifyStatus {
  pending
  sent
  failed
}

model SearchLog {
  id                    String   @id @default(uuid()) @db.Uuid
  queryRaw              String   @map("query_raw")
  queryNormalized       String   @map("query_normalized")
  qty                   Int?
  /// { providerId: 결과 수 | null(조회 불가) }
  resultCountByProvider Json     @map("result_count_by_provider")
  hasAnyStock           Boolean  @map("has_any_stock")
  /// 익명 세션 ID (쿠키). 개인 식별 정보 아님
  sessionId             String?  @map("session_id")
  /// 검색이 일어난 화면: search(/search) | part(/part/[mpn])
  source                String   @default("search")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inquiries Inquiry[]

  @@index([createdAt])
  @@index([queryNormalized])
  @@map("search_log")
}

model Inquiry {
  id                   String          @id @default(uuid()) @db.Uuid
  type                 InquiryType
  mpn                  String
  qty                  Int
  /// 희망 납기. null 이고 dueNegotiable=true 면 "협의"
  dueDate              DateTime?       @map("due_date") @db.Date
  dueNegotiable        Boolean         @default(false) @map("due_negotiable")
  itemCountBucket      ItemCountBucket @map("item_count_bucket")
  purchaseType         PurchaseType    @map("purchase_type")
  company              String?
  /// 개인정보 (보유기간 경과 시 삭제 대상)
  contactName          String?         @map("contact_name")
  phone                String?
  email                String?
  memo                 String?
  consentPrivacy       Boolean         @map("consent_privacy")
  /// 소싱 문의만 필수, 견적 문의는 null
  consentThirdParty    Boolean?        @map("consent_third_party")
  consentTextVersion   String          @map("consent_text_version")
  searchLogId          String?         @map("search_log_id") @db.Uuid
  status               InquiryStatus   @default(new)
  notifyStatus         NotifyStatus    @default(pending) @map("notify_status")
  /// 개인정보 파기 시각 (파기 배치가 기록)
  personalDataPurgedAt DateTime?       @map("personal_data_purged_at") @db.Timestamptz(3)
  /// 측정 (SEO_SPEC 8장): 첫 방문 기준 유입 정보
  landingUrl           String?         @map("landing_url")
  referrer             String?
  utmSource            String?         @map("utm_source")
  utmMedium            String?         @map("utm_medium")
  utmCampaign          String?         @map("utm_campaign")
  firstVisitAt         DateTime?       @map("first_visit_at") @db.Timestamptz(3)
  /// google | naver | ai | other_search | referral | direct
  trafficSource        String?         @map("traffic_source")
  /// 부품 페이지에서 접수된 경우
  partId               String?         @map("part_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  searchLog SearchLog? @relation(fields: [searchLogId], references: [id], onDelete: SetNull)
  part      Part?      @relation(fields: [partId], references: [id], onDelete: SetNull)

  /// 부품 요청의 품목들 (mpn·qty 는 첫 품목을 대표값으로 함께 저장)
  items       InquiryItem[]
  attachments InquiryAttachment[]

  @@index([createdAt])
  @@index([type, status])
  @@index([notifyStatus])
  @@index([partId])
  @@map("inquiry")
}

// ───────────── 부품 페이지 (docs/SEO_SPEC.md) ─────────────

enum PartLifecycle {
  active
  nrnd
  ltb
  eol
  unknown
}

enum PageStatus {
  draft
  review
  published
  unpublished
}

enum AltRelation {
  drop_in
  similar
  upgrade
}

enum FaqSource {
  inquiry
  manual
}

model Manufacturer {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  nameKo        String   @map("name_ko")
  nameEn        String   @map("name_en")
  descriptionKo String?  @map("description_ko")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parts    Part[]
  slugs    PartSlug[]
  variants PartVariant[]

  @@map("manufacturer")
}

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  nameKo        String   @map("name_ko")
  nameEn        String   @map("name_en")
  descriptionKo String?  @map("description_ko")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parts Part[]

  @@map("category")
}

model Part {
  id                 String        @id @default(uuid()) @db.Uuid
  /// 원본 품번 표기. 절대 덮어쓰지 않는다 (수정 시 이전 slug는 part_slug에 남아 301)
  mpnDisplay         String        @map("mpn_display")
  /// 정규화: 대문자, 공백·하이픈 제거
  mpnKey             String        @map("mpn_key")
  manufacturerId     String        @map("manufacturer_id") @db.Uuid
  categoryId         String?       @map("category_id") @db.Uuid
  package            String?
  summaryKo          String?       @map("summary_ko")
  /// LLM 요약 초안 (관리자가 적용하기 전까지 화면에 쓰이지 않음)
  summaryDraftKo     String?       @map("summary_draft_ko")
  summaryDraftAt     DateTime?     @map("summary_draft_at") @db.Timestamptz(3)
  /// [{label, value}] 관리자 입력
  keySpecs           Json          @default("[]") @map("key_specs")
  lifecycleStatus    PartLifecycle @default(unknown) @map("lifecycle_status")
  lifecycleCheckedAt DateTime?     @map("lifecycle_checked_at") @db.Timestamptz(3)
  lifecycleSource    String?       @map("lifecycle_source")
  eolDate            DateTime?     @map("eol_date") @db.Date
  /// 제조사 공식 URL만
  datasheetUrl       String?       @map("datasheet_url")
  pageStatus         PageStatus    @default(draft) @map("page_status")
  /// 품질 기준(SEO_SPEC 5.3) 계산값. 저장 시 갱신
  indexable          Boolean       @default(false)
  reviewedBy         String?       @map("reviewed_by")
  reviewedAt         DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  publishedAt        DateTime?     @map("published_at") @db.Timestamptz(3)
  /// 사이트맵 lastmod용: 실제 콘텐츠가 바뀐 시각
  contentUpdatedAt   DateTime      @default(now()) @map("content_updated_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  manufacturer     Manufacturer      @relation(fields: [manufacturerId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  slugs            PartSlug[]
  variants         PartVariant[]
  alternatives     PartAlternative[] @relation("PartAlternatives")
  alternativeOf    PartAlternative[] @relation("AlternativeTarget")
  faqs             PartFaq[]
  manufacturerFact ManufacturerFact?
  inquiries        Inquiry[]
  events           Event[]

  @@unique([manufacturerId, mpnKey])
  @@index([pageStatus, indexable])
  @@index([categoryId])
  @@index([lifecycleStatus])
  @@map("part")
}

/// slug ↔ 부품 매핑. 현재 정규 slug(isCanonical) + 과거 slug(301용)
model PartSlug {
  id             String   @id @default(uuid()) @db.Uuid
  partId         String   @map("part_id") @db.Uuid
  manufacturerId String   @map("manufacturer_id") @db.Uuid
  slug           String
  /// 대소문자·하이픈을 무시한 매칭 키
  slugKey        String   @map("slug_key")
  isCanonical    Boolean  @default(true) @map("is_canonical")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@unique([manufacturerId, slugKey])
  @@unique([manufacturerId, slug])
  @@index([partId])
  @@map("part_slug")
}

/// 변형 품번 (패키징 접미사 등). 별도 페이지 없이 기준 부품으로 301
model PartVariant {
  id             String @id @default(uuid()) @db.Uuid
  partId         String @map("part_id") @db.Uuid
  manufacturerId String @map("manufacturer_id") @db.Uuid
  mpnVariant     String @map("mpn_variant")
  mpnVariantKey  String @map("mpn_variant_key")
  /// URL 매칭용 (slugKey(slugifyMpn(mpnVariant)))
  variantSlugKey String @map("variant_slug_key")

  part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@unique([manufacturerId, mpnVariantKey])
  @@unique([manufacturerId, variantSlugKey])
  @@index([partId])
  @@map("part_variant")
}

model PartAlternative {
  id         String      @id @default(uuid()) @db.Uuid
  partId     String      @map("part_id") @db.Uuid
  /// 내부 페이지가 있는 대체품
  altPartId  String?     @map("alt_part_id") @db.Uuid
  /// 내부 페이지가 없는 대체품 품번
  altMpnText String?     @map("alt_mpn_text")
  relation   AltRelation
  noteKo     String?     @map("note_ko")
  verified   Boolean     @default(false)
  verifiedBy String?     @map("verified_by")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  part    Part  @relation("PartAlternatives", fields: [partId], references: [id], onDelete: Cascade)
  altPart Part? @relation("AlternativeTarget", fields: [altPartId], references: [id], onDelete: SetNull)

  @@index([partId])
  @@map("part_alternative")
}

model PartFaq {
  id              String    @id @default(uuid()) @db.Uuid
  partId          String    @map("part_id") @db.Uuid
  questionKo      String    @map("question_ko")
  answerKo        String    @map("answer_ko")
  source          FaqSource
  published       Boolean   @default(false)
  /// 문의에서 전환한 경우 원 문의 (개인정보는 FAQ에 옮기지 않는다)
  sourceInquiryId String?   @map("source_inquiry_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId, published])
  @@map("part_faq")
}

// ───────────── 제조사 공식 정보 수집 결과 (관리자 검토 대기) ─────────────

enum FactStatus {
  pending
  applied
  dismissed
  not_found
  failed
}

/// 부품별 최신 조회 결과 1건. 관리자가 반영(applied)하거나 무시(dismissed)한다
model ManufacturerFact {
  id        String     @id @default(uuid()) @db.Uuid
  partId    String     @unique @map("part_id") @db.Uuid
  sourceId  String     @map("source_id")
  status    FactStatus
  /// ManufacturerFacts JSON (사실 정보만)
  facts     Json?
  message   String?
  fetchedAt DateTime   @map("fetched_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("manufacturer_fact")
}

// ───────────── 측정 (docs/SEO_SPEC.md 8장) ─────────────

/// 행동 이벤트. 봇은 기록하지 않는다. 개인 식별 정보 없음 (익명 세션 ID)
model Event {
  id            String   @id @default(uuid()) @db.Uuid
  /// part_view | availability_view | sourcing_form_open | inquiry_submit
  type          String
  partId        String?  @map("part_id") @db.Uuid
  sessionId     String?  @map("session_id")
  path          String?
  trafficSource String?  @map("traffic_source")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  part Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([partId, type])
  @@map("event")
}

/// 색인 가능 페이지 수 일별 기록 (추이 지표용)
model IndexSnapshot {
  day            DateTime @id @db.Date
  publishedParts Int      @map("published_parts")
  indexableParts Int      @map("indexable_parts")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("index_snapshot")
}

/// 부품 요청 품목
model InquiryItem {
  id           String  @id @default(uuid()) @db.Uuid
  inquiryId    String  @map("inquiry_id") @db.Uuid
  position     Int
  mpn          String
  manufacturer String?
  qty          Int
  note         String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("inquiry_item")
}

/// 부품 요청 첨부 (BOM 등). 개인정보가 섞일 수 있어 보유기간 경과 시 함께 삭제한다
model InquiryAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  inquiryId   String   @map("inquiry_id") @db.Uuid
  filename    String
  contentType String   @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("inquiry_attachment")
}
