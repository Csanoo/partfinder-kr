# 이 파일을 .env 로 복사해서 사용한다. 실제 API 키는 저장소에 커밋하지 않는다.

# --- 유통사 Provider feature flag (기본값: 모두 off) ---
# 개발·테스트용 mock Provider (fixture JSON 사용)
PROVIDER_MOCK_ENABLED=true
# Mouser: API 키 발급 후 켠다 (6단계에서 구현)
PROVIDER_MOUSER_ENABLED=false
# DigiKey: 외부 사이트 표시 사전 승인 회신 전까지 프로덕션에서 켜지 말 것 (7단계에서 구현)
PROVIDER_DIGIKEY_ENABLED=false

# 공개 웹페이지 수집 소스 (broker). 이용약관 검토 전까지 off
PROVIDER_HEISENER_ENABLED=false
PROVIDER_CENSTRY_ENABLED=false
PROVIDER_WORLDWAY_ENABLED=false
PROVIDER_HKINVENTORY_ENABLED=false
# 수집 요청 User-Agent (식별 가능하게, 연락처 포함). TODO(확인필요): 연락처
# SCRAPER_USER_AGENT=partfinder-kr/0.1 (+https://example.com/contact)

# --- 관리자 (Basic Auth). 비우면 관리자 화면 접근 불가 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- 색인 품질 기준 (docs/SEO_SPEC.md 5.3) ---
# SEO_MIN_SUMMARY_LENGTH=80
# SEO_LIFECYCLE_MAX_AGE_MONTHS=12
# SEO_MIN_KEY_SPECS=3
# SEO_MIN_OPTIONAL_SIGNALS=2

# --- 검색엔진 (docs/SEO_SPEC.md 6.2, 6.5) ---
# 사이트 소유 확인 태그 값 (meta content 값만)
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=
# AI 크롤러 목록 덮어쓰기 (쉼표 구분). 기본: 검색·답변용 허용, 학습용 차단
# AI_CRAWLERS_ALLOW=OAI-SearchBot,ChatGPT-User,PerplexityBot,Perplexity-User,Claude-SearchBot,Claude-User
# AI_CRAWLERS_BLOCK=GPTBot,ClaudeBot,Google-Extended,Applebot-Extended,CCBot,Bytespider,meta-externalagent
# 사이트맵 파일당 URL 수 (최대 50000)
# SITEMAP_CHUNK_SIZE=50000
# 허브 색인 기준 (게시 부품 수)
# SEO_HUB_MIN_PARTS=5

# --- 문의 알림 메일 (docs/SPEC.md 6장) ---
# 발송 방식: console(개발용, 로그 출력). TODO(확인필요): ses / resend 등 운영 서비스
MAIL_PROVIDER=console
# 수신 주소 (운영자만, 쉼표로 여러 개). 견적·소싱 각각, 없으면 NOTIFY_EMAIL 공통
NOTIFY_EMAIL_QUOTE=
NOTIFY_EMAIL_SOURCING=
# NOTIFY_EMAIL=

# --- 요약 초안 (LLM, 선택 기능: docs/SEO_SPEC.md 7장) ---
# true 이고 Anthropic API 키가 있을 때만 관리자 편집 화면의 "요약 초안 만들기"가 켜진다
SUMMARY_DRAFT_ENABLED=false
# ANTHROPIC_API_KEY=

# --- 개인정보 ---
# 문의 개인정보 보유기간(일). 비우면 파기 작업이 아무것도 지우지 않는다. TODO(확인필요): 기간
# PERSONAL_DATA_RETENTION_DAYS=

# --- 사이트 ---
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- 검색 ---
# 응답 캐시 TTL(초). 기본 900(15분).
# TODO(확인필요): 유통사 약관상 캐시 허용 범위 회신 대기
SEARCH_CACHE_TTL_SECONDS=900
# Provider 한 곳의 조회 제한 시간(ms)
PROVIDER_TIMEOUT_MS=8000
