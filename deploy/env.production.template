# MS전자 운영 설정 (/etc/partfinder/env). setup-server.sh 가 처음 한 번 만든다.
# 수정 후: sudo systemctl restart partfinder
# systemd EnvironmentFile 형식: 공백이 있는 값은 큰따옴표로 감싼다.

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
SITE_URL=https://__DOMAIN__

DATABASE_URL=postgresql://partfinder:__DB_PASS__@127.0.0.1:5432/partfinder

# 관리자 (Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ADMIN_PASS__

# 서버 cron → /api/cron/{job}
CRON_SECRET=__CRON_SECRET__
CRON_FACTS_LIMIT=100

# 문의 알림 메일 — Resend 도메인 인증 후 resend 로 바꾼다
MAIL_PROVIDER=console
# RESEND_API_KEY=
# MAIL_FROM="MS전자 <noreply@__DOMAIN__>"
NOTIFY_EMAIL_QUOTE=
NOTIFY_EMAIL_SOURCING=

# 유통사 Provider (운영에서 mock 은 끈다)
PROVIDER_MOCK_ENABLED=false
PROVIDER_MOUSER_ENABLED=false
PROVIDER_DIGIKEY_ENABLED=false
PROVIDER_HEISENER_ENABLED=false
PROVIDER_CENSTRY_ENABLED=false
PROVIDER_WORLDWAY_ENABLED=false
PROVIDER_HKINVENTORY_ENABLED=false
SEARCH_CACHE_TTL_SECONDS=900
PROVIDER_TIMEOUT_MS=8000
# SCRAPER_USER_AGENT="partfinder-kr/0.1 (+https://__DOMAIN__/contact)"

# 검색엔진 소유 확인
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=

# 요약 초안 (선택)
SUMMARY_DRAFT_ENABLED=false
# ANTHROPIC_API_KEY=

# 개인정보 보유기간(일) — 정해지면 설정
# PERSONAL_DATA_RETENTION_DAYS=
